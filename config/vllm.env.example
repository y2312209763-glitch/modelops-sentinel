# Required: local model directory and API-visible model name.
MODEL_PATH=/models/MiniMax-M2.5
SERVED_MODEL_NAME=MiniMax-M2.5

# Never commit a real key. Copy this file to vllm.env before editing.
VLLM_API_KEY=replace-me

# Server and parallelism.
VLLM_HOST=0.0.0.0
VLLM_PORT=8000
TENSOR_PARALLEL_SIZE=8
ENABLE_EXPERT_PARALLEL=1

# Enable only for a model repository you trust.
TRUST_REMOTE_CODE=1

# Model-specific parsers. Leave empty when the model does not need them.
TOOL_CALL_PARSER=minimax_m2
REASONING_PARSER=minimax_m2_append_think

# Optional flags appended to `vllm serve`, separated by spaces.
# Example: --max-model-len 32768 --gpu-memory-utilization 0.9
VLLM_EXTRA_ARGS=

# Used by the smoke test and audit CLI.
VLLM_BASE_URL=http://127.0.0.1:8000
VLLM_MODEL=MiniMax-M2.5
PROMETHEUS_URL=http://127.0.0.1:9090

